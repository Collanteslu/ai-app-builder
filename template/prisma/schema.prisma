generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Implementa: template base
/// Entidad mínima para que prisma generate produzca un cliente funcional.
/// El scaffold de la Fase 5 añade las entidades reales del modelo de datos.
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
